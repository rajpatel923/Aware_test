-- Identity table
CREATE TABLE IF NOT EXISTS identity (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    username TEXT NOT NULL
);

-- All messages (outbox + inbox)
CREATE TABLE IF NOT EXISTS messages (
    client_message_id TEXT PRIMARY KEY,
    sender TEXT NOT NULL,
    recipient TEXT NOT NULL,
    text TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'queued',
    sequence INTEGER,
    accepted_at TEXT,
    error_code TEXT
);

-- Sync state
CREATE TABLE IF NOT EXISTS sync_state (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    epoch TEXT,
    pending_epoch TEXT,
    cursor INTEGER NOT NULL DEFAULT 0
);

-- Seed sync_state row
INSERT OR IGNORE INTO sync_state (id, cursor) VALUES (1, 0);

-- Identity queries
loadIdentity:
SELECT username FROM identity WHERE id = 1;

saveIdentity:
INSERT INTO identity (id, username) VALUES (1, ?)
ON CONFLICT(id) DO UPDATE SET username = excluded.username;

-- Message queries
insertQueued:
INSERT INTO messages (client_message_id, sender, recipient, text, status)
VALUES (?, ?, ?, ?, 'queued');

pendingMessages:
SELECT client_message_id, sender, recipient, text
FROM messages WHERE status = 'queued' ORDER BY rowid;

acknowledgeMessage:
UPDATE messages SET status = 'accepted', sequence = ?, accepted_at = ?
WHERE client_message_id = ? AND status = 'queued';

failMessage:
UPDATE messages SET status = 'failed', error_code = ?
WHERE client_message_id = ? AND status = 'queued';

messageByIdAndStatus:
SELECT status FROM messages WHERE client_message_id = ?;

insertAccepted:
INSERT INTO messages (client_message_id, sender, recipient, text, status, sequence)
VALUES (?, ?, ?, ?, 'accepted', ?);

acceptQueuedByInbox:
UPDATE messages SET status = 'accepted', sequence = ?
WHERE client_message_id = ? AND status = 'queued';

allMessages:
SELECT client_message_id, sender, recipient, text, status, sequence, error_code
FROM messages ORDER BY COALESCE(sequence, 9999999999), rowid;

messagesByPeer:
SELECT client_message_id, sender, recipient, text, status, sequence, error_code
FROM messages WHERE sender = ? OR recipient = ?
ORDER BY COALESCE(sequence, 9999999999), rowid;

pendingCount:
SELECT COUNT(*) FROM messages WHERE status = 'queued';

-- Sync state queries
loadSyncState:
SELECT epoch, pending_epoch, cursor FROM sync_state WHERE id = 1;

updateEpoch:
UPDATE sync_state SET epoch = ?, pending_epoch = ? WHERE id = 1;

updateCursor:
UPDATE sync_state SET cursor = ? WHERE id = 1;

resetSession:
UPDATE sync_state SET epoch = ?, pending_epoch = NULL, cursor = 0 WHERE id = 1;
