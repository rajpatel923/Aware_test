{
  "description": "A client queues a message while offline, then shuts down. After restarting with the same data directory the message must still be pending, and the client must send it successfully on reconnect. behavior.md 4.1–4.4. Run with each language as sender.",
  "roles": [{"alice": "swift", "bob": "kotlin"}, {"alice": "kotlin", "bob": "swift"}],
  "steps": [
    {"client": "alice", "cmd": "identify", "args": {"name": "alice"}},
    {"client": "bob",   "cmd": "identify", "args": {"name": "bob"}},

    {"client": "alice", "cmd": "offline", "args": {"enabled": true}},
    {"client": "alice", "cmd": "send", "args": {"recipient": "bob", "text": "Survives a restart"}, "bind": "m1"},
    {"client": "alice", "cmd": "snapshot", "expect": {"result": {"pending_count": 1}, "contains": [{"client_message_id": "$m1", "status": "queued"}]}},
    {"client": "alice", "cmd": "shutdown"},

    {"cmd": "restart", "client": "alice", "note": "harness directive: start a new alice runner with the same data directory; $m1 binding is retained by the harness"},

    {"client": "alice", "cmd": "snapshot", "expect": {"result": {"pending_count": 1}, "contains": [{"client_message_id": "$m1", "status": "queued"}], "note": "queue must survive restart"}},
    {"client": "alice", "cmd": "offline", "args": {"enabled": false}},
    {"client": "alice", "cmd": "sync_once", "expect": {"result": {"outcome": "ok", "pending": 0}}},
    {"client": "alice", "cmd": "snapshot", "expect": {"contains": [{"client_message_id": "$m1", "status": "accepted"}]}},

    {"client": "bob", "cmd": "sync_once", "expect": {"result": {"outcome": "ok", "received": 1}}},
    {"client": "bob", "cmd": "snapshot", "expect": {"contains": [{"client_message_id": "$m1", "sender": "alice", "text": "Survives a restart", "status": "accepted"}]}},

    {"client": "alice", "cmd": "shutdown"},
    {"client": "bob",   "cmd": "shutdown"}
  ]
}
