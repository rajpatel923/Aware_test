{
  "description": "Server accepts a message but the response is lost. The client must retry with the same ID; the server must not create a second message; the recipient must see it once. behavior.md 5.4, 5.6, 6.1, 7.4. Run with each language as sender.",
  "roles": [{"alice": "swift", "bob": "kotlin"}, {"alice": "kotlin", "bob": "swift"}],
  "steps": [
    {"client": "alice", "cmd": "identify", "args": {"name": "alice"}},
    {"client": "bob", "cmd": "identify", "args": {"name": "bob"}},
    {"client": "alice", "cmd": "send", "args": {"recipient": "bob", "text": "Sent once, acknowledged twice"}, "bind": "m1"},
    {"client": "alice", "cmd": "fault", "args": {"drop_next_response": "submit"}},
    {"client": "alice", "cmd": "sync_once", "expect": {"result": {"outcome": "backoff", "pending": 1}}},
    {"client": "alice", "cmd": "snapshot", "expect": {"contains": [{"client_message_id": "$m1", "status": "queued"}]}},
    {"client": "alice", "cmd": "sync_once", "expect": {"result": {"outcome": "ok", "pending": 0}}},
    {"client": "alice", "cmd": "snapshot", "expect": {"contains": [{"client_message_id": "$m1", "status": "accepted"}]}},
    {"client": "bob", "cmd": "sync_once", "expect": {"result": {"outcome": "ok", "received": 1}}},
    {"client": "bob", "cmd": "snapshot", "expect": {"contains": [{"client_message_id": "$m1", "status": "accepted"}]}},
    {"client": "alice", "cmd": "shutdown"},
    {"client": "bob", "cmd": "shutdown"}
  ]
}
