{
  "description": "The recipient's inbox spans more than one page. The client must fetch all pages in order, advance the cursor correctly, and not miss or duplicate any message. behavior.md 7.1–7.4. Run with each language as receiver. Requires runners started with --page-size 2.",
  "roles": [{"alice": "swift", "bob": "kotlin"}, {"alice": "kotlin", "bob": "swift"}],
  "runner_options": {"page_size": 2},
  "steps": [
    {"client": "alice", "cmd": "identify", "args": {"name": "alice"}},
    {"client": "bob",   "cmd": "identify", "args": {"name": "bob"}},

    {"client": "alice", "cmd": "send", "args": {"recipient": "bob", "text": "Page one, message one"},   "bind": "m1"},
    {"client": "alice", "cmd": "send", "args": {"recipient": "bob", "text": "Page one, message two"},   "bind": "m2"},
    {"client": "alice", "cmd": "send", "args": {"recipient": "bob", "text": "Page two, message one"},   "bind": "m3"},
    {"client": "alice", "cmd": "sync_once", "expect": {"result": {"outcome": "ok", "pending": 0}}},

    {"client": "bob", "cmd": "sync_once", "expect": {"result": {"outcome": "ok", "received": 2}, "note": "first page: m1 and m2; has_more is true so engine runs another cycle"}},
    {"client": "bob", "cmd": "sync_once", "expect": {"result": {"outcome": "ok", "received": 1}, "note": "second page: m3; has_more is false"}},
    {"client": "bob", "cmd": "sync_once", "expect": {"result": {"outcome": "ok", "received": 0}, "note": "third call: no new messages, cursor stable"}},

    {"client": "bob", "cmd": "snapshot", "expect": {
      "result": {"pending_count": 0},
      "contains": [
        {"client_message_id": "$m1", "sender": "alice", "text": "Page one, message one", "status": "accepted"},
        {"client_message_id": "$m2", "sender": "alice", "text": "Page one, message two", "status": "accepted"},
        {"client_message_id": "$m3", "sender": "alice", "text": "Page two, message one", "status": "accepted"}
      ]
    }},

    {"client": "alice", "cmd": "shutdown"},
    {"client": "bob",   "cmd": "shutdown"}
  ]
}
